{
  "name": "pinger-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node ../scripts/generate-icons.mjs",
    "icons:check": "node ../scripts/generate-icons.mjs --check",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "eslint src",
    "preview": "vite preview"
  },
  "overrides": {
    "katex": "$katex",
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.1.2",
    "@fontsource/space-grotesk": "^5.3.0",
    "@wailsio/runtime": "3.0.0-beta.30",
    "emoji-picker-react": "^5.1.0",
    "franc-min": "^6.2.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.19",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  }
}
