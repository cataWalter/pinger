{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Pinger: Hot reload",
			"type": "process",
			"command": "bash",
			"args": [
				"scripts/dev.sh"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always"
			}
		},
		{
			"label": "Pinger: Run normally",
			"type": "process",
			"command": "go",
			"args": [
				"run",
				"-tags=sqlite_fts5,goolm",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"GOTOOLCHAIN": "go1.26.10"
				}
			},
			"problemMatcher": [],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always"
			}
		},
		{
			"label": "Pinger: Install on macOS",
			"type": "process",
			"command": "bash",
			"args": [
				"scripts/install-macos-app.sh"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always"
			}
		},
		{
			"label": "Pinger: Check publication",
			"type": "shell",
			"command": "gh run list --repo cataWalter/pinger --workflow release.yml --branch main --limit 1 --json status,conclusion,url",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}