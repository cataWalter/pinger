{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Pinger: Build and run Qt client",
			"type": "shell",
			"command": "task run",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"GOTOOLCHAIN": "go1.26.11"
				}
			},
			"problemMatcher": [],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always"
			}
		},
		{
			"label": "Pinger: Run Qt client with hot reload",
			"type": "shell",
			"command": "sh scripts/dev/qt6-dev.sh",
			"isBackground": true,
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"GOTOOLCHAIN": "go1.26.11"
				}
			},
			"problemMatcher": [],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always"
			}
		}
	]
}
